# Portal under test. Member portal and advisor portal ship from one deployment.
BASE_URL=https://dev.aperion.health

# Protected route the smoke test probes - depends on the account you log in with.
#   advisor / wellness coach -> /wellness/dashboard  (default)
#   member                   -> /member/dashboard
# SMOKE_ROUTE=/wellness/dashboard

# Designated member account for session / care-scheduler test data.
# TEST_MEMBER_EMAIL=your-test-member@example.com

# Set to 1 to skip the pre-flight access-token refresh before recording/running.
# APERION_NO_AUTO_REFRESH=1

# NOTE: there is deliberately no OTP / password entry here.
# Login is always performed by hand - see README.md.
